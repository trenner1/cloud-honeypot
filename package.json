{
  "name": "cloud-honeypot",
  "version": "1.0.0",
  "description": "Automated AWS deploy of the SANS ISC DShield honeypot",
  "private": true,
  "bin": {
    "cloud-honeypot": "bin/cloud-honeypot.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "cdk": "cdk",
    "synth": "cdk synth --strict",
    "deploy": "bash scripts/deploy.sh",
    "ssm": "bash scripts/ssm.sh",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "aws-cdk": "2.1137.0",
    "eslint": "10.11.0",
    "eslint-plugin-awscdk": "4.4.3",
    "jest": "30.5.2",
    "ts-jest": "29.4.13",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1"
  }
}
